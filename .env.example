NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Local seed scripts only. Never expose this key to the browser or commit its value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required by /api/auth/send-login-email. Generate a random 32+ character
# secret and set it in Vercel for Production, Preview, and Development.
LOGIN_RATE_LIMIT_PEPPER=replace-with-a-long-random-secret
# Prefer a Supabase secret key (sb_secret_...) for this route. It enables
# Supabase Auth's optional end-user IP forwarding as an additional safeguard.
SUPABASE_SECRET_KEY=your-supabase-secret-key
NEXT_PUBLIC_EMAIL_LINK_LOGIN_ENABLED=false
# Defaults: 5 requests/IP/10 minutes, 3/email/hour, then 24-hour IP ban after
# 21 attempts/hour. Override only within the documented bounds in the route.
LOGIN_EMAIL_IP_MAX_REQUESTS=5
LOGIN_EMAIL_IP_WINDOW_SECONDS=600
LOGIN_EMAIL_MAX_REQUESTS=3
LOGIN_EMAIL_WINDOW_SECONDS=3600
LOGIN_EMAIL_BAN_THRESHOLD=20
LOGIN_EMAIL_BAN_WINDOW_SECONDS=3600
LOGIN_EMAIL_BAN_DURATION_SECONDS=86400
# Required only when intentionally running `npm run seed:test-history`.
ALLOW_TEST_DATA_SEED=false

